{
  "expo": {
    "name": "BROOMSTICK",
    "slug": "witch-walk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./Photos/Broomstick App LOGO.png",
    "scheme": "witchwalk",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.housearauz.witchwalk",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./Photos/Broomstick App LOGO.png",
        "backgroundColor": "#170E24"
      },
      "package": "com.housearauz.witchwalk",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./Photos/Broomstick App LOGO.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow BROOMSTICK to use your precise location when you choose Locate Me or report a wait time near a Salem attraction."
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4ef37aa2-d412-4788-8da7-de904b97ec2b"
      }
    },
    "owner": "housearauz"
  }
}
